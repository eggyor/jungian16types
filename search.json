---
layout: null
sitemap: false
---
[
{%- assign search_index_first = true -%}
{%- for post in site.posts -%}
  {%- capture search_text -%}{{ post.content | strip_html | normalize_whitespace | strip }}{%- endcapture -%}
  {%- unless search_index_first -%},{%- endunless -%}
  {"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"type":"文章","content":{{ search_text | jsonify }}}
  {%- assign search_index_first = false -%}
{%- endfor -%}
{%- for page in site.pages -%}
  {%- if page.title and page.url != '/search/' and page.path != 'search.json' and page.path contains '.html' -%}
    {%- capture search_text -%}{{ page.content | strip_html | normalize_whitespace | strip }}{%- endcapture -%}
    {%- unless search_index_first -%},{%- endunless -%}
    {"title":{{ page.title | jsonify }},"url":{{ page.url | relative_url | jsonify }},"type":"頁面","content":{{ search_text | jsonify }}}
    {%- assign search_index_first = false -%}
  {%- endif -%}
{%- endfor -%}
]
